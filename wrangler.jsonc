{
  "name": "peligaming",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // by default a request that matches a static asset is served without the
    // worker running at all, which would leave the pages out of the host
    // redirect below; the worker must see every request first
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "peligaming.com", "custom_domain": true },
    // www and the site's old home are attached too, only so the worker can
    // answer them with a 301 to peligaming.com (see REDIRECT_HOSTS in the worker)
    { "pattern": "www.peligaming.com", "custom_domain": true },
    { "pattern": "gaming.peliglot.com", "custom_domain": true }
  ]
}
